# ============================================
# docker-compose.prod.yml uchun muhit o'zgaruvchilari.
# `infra/.env.prod` sifatida nusxalab to'ldiring (yoki `--env-file` bilan bering).
# ============================================

# PostgreSQL
POSTGRES_DB=adolat_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD

# Admin (Next.js) build vaqtida inline qilinadigan API manzili.
# <DOMEN> ni o'zingizniki bilan almashtiring.
API_URL=https://api.<DOMEN>/api/v1
