# ============================================
# Adolat AI — Backend environment example
# Hech qachon haqiqiy qiymatlarni git'ga commit qilmang.
# ============================================

NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

DATABASE_URL=postgresql://adolat:adolat@localhost:5432/adolat_ai?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- AI Router ----------
# Qo'llab-quvvatlanadigan provayderlar: openai | gemini | claude
# Birinchisi ishlamasa, navbatdagisiga avtomatik o'tiladi (fallback chain).
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=claude
AI_FALLBACK_PROVIDER_2=gemini
AI_TIMEOUT_MS=30000
AI_RETRY_COUNT=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Claude (Anthropic) — qo'shimcha provayder sifatida ulangan
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

STT_PROVIDER=openai
TTS_PROVIDER=openai

SMS_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

FCM_SERVER_KEY=

ADMIN_DEFAULT_EMAIL=admin@adolat.ai
ADMIN_DEFAULT_PASSWORD=

MOBILE_API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3000
