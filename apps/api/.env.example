# ============================================
# Adolat AI — Backend environment example
# Hech qachon haqiqiy qiymatlarni git'ga commit qilmang.
# ============================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adolat_ai?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# ---------- OTP (telefon/email tasdiqlash) ----------
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- AI Router ----------
# Qo'llab-quvvatlanadigan provayderlar: openai | gemini | claude
# Birinchisi ishlamasa, navbatdagisiga avtomatik o'tiladi (fallback chain).
# Test endpoint faqat dev/staging'da yoqilsin; production'da false qo'ying.
AI_ENABLE_TEST_ENDPOINT=true
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_PROVIDER_2=claude
AI_TIMEOUT_MS=30000
AI_RETRY_COUNT=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Claude (Anthropic) — master-spec'da ko'rsatilmagan, qo'shimcha uchinchi provayder sifatida ulandi
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

ADMIN_DEFAULT_EMAIL=admin@adolat-ai.uz
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
