# ============================================
# Adolat AI — Backend PRODUCTION env namunasi
# `apps/api/.env.prod` sifatida nusxalab, haqiqiy qiymatlar bilan to'ldiring.
# Hech qachon git'ga commit qilmang.
#  <DOMEN>  ->  o'z domeningiz (masalan: adolat.uz)
# ============================================

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# Domenlaringiz (CORS shu URL'lardan quriladi)
FRONTEND_URL=https://<DOMEN>
ADMIN_URL=https://admin.<DOMEN>

# docker-compose ichidagi 'postgres' va 'redis' servislariga ulanish.
# Parollarni infra/.env.prod dagi qiymatlar bilan bir xil qiling.
DATABASE_URL=postgresql://postgres:CHANGE_DB_PASSWORD@postgres:5432/adolat_ai?schema=public
REDIS_URL=redis://:CHANGE_REDIS_PASSWORD@redis:6379

# Kuchli tasodifiy maxfiy kalitlar (masalan: openssl rand -hex 32)
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- AI (faqat Gemini) ----------
AI_ENABLE_TEST_ENDPOINT=false
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_PROVIDER_2=
AI_TIMEOUT_MS=30000
AI_RETRY_COUNT=2

GEMINI_API_KEY=CHANGE_ME_GEMINI_KEY
GEMINI_MODEL=gemini-1.5-flash

# OpenAI/Claude ishlatilmaydi (bo'sh qoldiring)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Embeddings (RAG) — Gemini ----------
EMBEDDINGS_PROVIDER=gemini
EMBEDDINGS_MODEL=text-embedding-004
EMBEDDINGS_DIMENSIONS=768
RAG_MIN_SIMILARITY=0.70

# ---------- Avto-sinxron (lex.uz va boshqa manbalar) ----------
# Har soat ishga tushadi; har manba syncIntervalHours bo'yicha yangilanadi.
INGESTION_AUTO_SYNC=true
SYNC_INTERVAL_DEFAULT_HOURS=24

# ---------- To'lov (Click / Payme) ----------
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Fayl saqlash ----------
# S3_BUCKET bo'sh bo'lsa lokal disk ishlatiladi.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# ---------- Push (FCM HTTP v1) — ixtiyoriy ----------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------- Voice (hozircha o'chiq — "tez kunda") ----------
# STT/TTS OpenAI talab qiladi; hozircha bo'sh.
STT_PROVIDER=openai
TTS_PROVIDER=openai

# ---------- Admin boshlang'ich foydalanuvchi (seed) ----------
ADMIN_DEFAULT_EMAIL=admin@<DOMEN>
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
